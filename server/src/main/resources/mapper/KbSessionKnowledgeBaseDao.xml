<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentcore.server.dao.KbSessionKnowledgeBaseDao">

    <select id="findKbId" resultType="java.lang.String">
        SELECT kb_id FROM session_knowledge_bases WHERE session_id = #{sessionId} LIMIT 1
    </select>

    <insert id="insert">
        INSERT INTO session_knowledge_bases (session_id, kb_id)
        VALUES (#{sessionId}, #{kbId})
    </insert>

    <delete id="deleteBySession">
        DELETE FROM session_knowledge_bases WHERE session_id = #{sessionId}
    </delete>

    <select id="countByKb" resultType="long">
        SELECT COUNT(*) FROM session_knowledge_bases WHERE kb_id = #{kbId}
    </select>

</mapper>

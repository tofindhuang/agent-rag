<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentcore.server.dao.AuditEventDao">

    <sql id="auditColumns">
        id, actor_user_id, actor_type, action, target_type, target_id, outcome,
        ip, user_agent, detail, created_at
    </sql>

    <select id="listByActor" resultType="com.agentcore.server.domain.AuditEvent">
        SELECT <include refid="auditColumns"/>
        FROM audit_events
        WHERE actor_user_id = #{actorUserId}
        <if test="beforeId != null">
            AND id &lt; #{beforeId}
        </if>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <select id="listAll" resultType="com.agentcore.server.domain.AuditEvent">
        SELECT <include refid="auditColumns"/>
        FROM audit_events
        <where>
            <if test="action != null and action != ''">
                action = #{action}
            </if>
            <if test="beforeId != null">
                AND id &lt; #{beforeId}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteOlderThan">
        DELETE FROM audit_events WHERE created_at &lt; #{cutoff}
    </delete>

</mapper>

{
  "contractVersion": "1",
  "kind": "consumer",
  "name": "interrupted-stream",
  "description": "领域事件流缺少 run_settled 时，消费者合成 STREAM_INTERRUPTED 并把已产生文本落成 partial",
  "input": {
    "frames": [
      {
        "seq": 1,
        "event": "run_started",
        "data": {
          "runId": "run-1",
          "turnId": "turn-1",
          "sessionId": "session-1",
          "contractVersion": "1"
        }
      },
      { "seq": 2, "event": "text_delta", "data": { "delta": "部分回复" } }
    ]
  },
  "expected": {
    "syntheticTerminal": {
      "status": "error",
      "turnId": "turn-1",
      "error": {
        "code": "STREAM_INTERRUPTED",
        "message": "连接中断，未收到终态",
        "retryable": false
      }
    },
    "userDeliveryStatus": "sent",
    "assistant": {
      "status": "partial",
      "text": "部分回复"
    },
    "invariants": {
      "inputTerminalCount": 0,
      "syntheticTerminalCount": 1
    }
  }
}

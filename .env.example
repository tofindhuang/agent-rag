# Copy to .env (or export in your shell). Development defaults shown.

# gateway (Node, pi engine)
GATEWAY_PORT=3001
GATEWAY_API_TOKEN=
GATEWAY_LOG_PI_EVENTS=0
JAVA_API_URL=http://localhost:8080
SANDBOX_API_URL=http://localhost:8080
# gateway compaction (FR-4); reserve is computed per model window
COMPACTION_ENABLED=true
COMPACTION_RESERVE_RATIO=0.2
COMPACTION_KEEP_RECENT_TOKENS=20000
# gateway profile extraction (FR-5)
PROFILE_EXTRACT_MIN_INTERVAL_MS=60000
PROFILE_EXTRACT_MAX_MESSAGES=30
PROFILE_EXTRACT_MAX_CHARS=6000
PROFILE_EXTRACT_MAX_CANDIDATES=5

# server (Java business layer)
GATEWAY_URL=http://localhost:3001
# HS256 access-token key (>=32 bytes).
JWT_SECRET=dev-only-jwt-secret-at-least-32-bytes!!
AUTH_COOKIE_SECURE=false
# Base64 of 32 bytes; encrypts user-supplied provider API keys (ADR-0010).
MODEL_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MODEL_ALLOW_PRIVATE_ENDPOINTS=false
ALLOW_SYSTEM_DEFAULT_MODEL=true
MYSQL_HOST=localhost
MYSQL_USER=agent_core
MYSQL_PASSWORD=agent_core
REDIS_HOST=localhost
REDIS_PORT=6379
# server profile injection budget (FR-5)
PROFILE_MAX_FACTS=20
PROFILE_MAX_CHARS=4000

# server rate limits (FR-6); enabled=false is the incident switch
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_RPM=120
RATE_LIMIT_USER_TPM=100000
RATE_LIMIT_AUTH_IP_RPM=10
RATE_LIMIT_WINDOW=60s
# Prometheus scrape endpoint (separate management port)
MANAGEMENT_PORT=9091

# server RAG (encoder/reranker; OpenAI-compatible endpoints)
# Keys stay in the server environment/secret store, never in the repo.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PATH=/embeddings
RERANK_ENABLED=true
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PATH=/rerank
RERANK_CANDIDATES=10
RERANK_TOP_N=5

# server KB infrastructure (FR-2; docker-compose defaults shown)
KB_ENABLED=true
KB_ALLOW_PRIVATE_ENDPOINTS=false
KB_MAX_DOCUMENTS_PER_USER=200
KB_MAX_BYTES_PER_USER=1073741824
KB_WORKER_THREADS=3
KB_QUEUE_PREFIX=kb

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=agent_core
RABBITMQ_PASSWORD=agent_core_dev_only
RABBITMQ_VHOST=/

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=kb_passages

# S3-compatible originals store (Silo / MinIO / cloud S3).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=agent_core
S3_SECRET_KEY=agent_core_dev_only
S3_BUCKET=agent-core-kb
S3_REGION=us-east-1
S3_PATH_STYLE=true

# web (Next.js)
NEXT_PUBLIC_API_BASE=http://localhost:8080
